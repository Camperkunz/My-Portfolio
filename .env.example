# ---------------------------------------------------------------------------
# Contact form (server-side only — read by /api/contact, never bundled)
# ---------------------------------------------------------------------------

# Resend API key: https://resend.com/api-keys
# Keep it server-side. Never prefix it with VITE_, which would expose it to
# the browser bundle.
RESEND_API_KEY=

# Where submissions are delivered. Comma-separated for multiple recipients.
CONTACT_TO_EMAIL=

# Verified sender address. Before verifying a domain in Resend, use the shared
# test sender below — Resend only delivers it to the account owner's address.
CONTACT_FROM_EMAIL=

# Optional prefix for the notification subject line.
CONTACT_SUBJECT_PREFIX="Portfolio contact"

# Optional comma-separated allow-list of browser origins. When empty, only the
# host that served the request is accepted, which is correct for the deployed
# site and the local dev server.
CONTACT_ALLOWED_ORIGINS=
